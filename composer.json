{
    "name": "britech/britech",
    "description": "Britech - Plataforma de gestion y venta de productos tecnologicos",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^7.1",
        "dompdf/dompdf": "^3.1",
        "auth0/auth0-php": "^9.0",
        "guzzlehttp/guzzle": "^8.2",
        "guzzlehttp/psr7": "^3.1",
        "composer/ca-bundle": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
